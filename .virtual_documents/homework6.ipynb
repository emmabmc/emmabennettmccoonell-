import numpy as np


list = [20, 27, 9, 12, 31, 17, 4, 50, 39, 35]
arr = np.array(list)


print(arr * 4)


print(np.mean(arr))


print(np.median(arr))


x = np.argmin(arr)
y = np.argmax(arr)
print(x)
print(y)
print(arr[x])
print(arr[y])


newarray = arr[arr > 20]
print(newarray)


matrix = [[5, 12, 17, 9], [8, 21, 14, 3], [6, 13, 19, 11]]
arr = np.array(matrix)


print(np.shape(arr))


print(arr[:, 2])


print(arr[1, :])


print(arr * 2)


print(np.mean(arr[0, :]))


print(np.mean(arr[1, :]))


print(np.mean(arr[2, :]))


print(np.mean(arr))



